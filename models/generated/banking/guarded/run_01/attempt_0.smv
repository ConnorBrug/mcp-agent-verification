MODULE main
VAR
  action     : {idle, read_trusted, read_untrusted, send_external, confirm, delete, request_grant};
  tainted    : boolean;
  confirmed  : boolean;
  privileged : boolean;
  grant      : boolean;
  -- Mapping of tools to actions:
  -- get_balance, get_iban, get_most_recent_transactions, get_scheduled_transactions, get_user_info -> read_trusted
  -- read_file -> read_untrusted
  -- schedule_transaction, send_money, update_password, update_scheduled_transaction, update_user_info -> send_external

ASSIGN
  init(action) := idle;
  init(tainted) := FALSE;
  init(confirmed) := FALSE;
  init(privileged) := FALSE;
  -- grant is a free input

  next(action) :=
    case
      tainted & action = send_external : idle;
      action = delete & !confirmed : idle;
      action = request_grant & !grant : idle;
      TRUE : {idle, read_trusted, read_untrusted, send_external, confirm, delete, request_grant};
    esac;

  next(tainted) :=
    case
      action = read_untrusted : TRUE;
      TRUE : tainted;
    esac;

  next(confirmed) :=
    case
      action = confirm : TRUE;
      TRUE : FALSE;
    esac;

  next(privileged) :=
    case
      action = request_grant & grant : TRUE;
      TRUE : privileged;
    esac;
