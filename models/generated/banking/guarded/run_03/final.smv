MODULE main

VAR
  action     : {idle, read_trusted, read_untrusted, send_external, confirm, delete, request_grant};
  tainted    : boolean;
  confirmed  : boolean;
  privileged : boolean;
  grant      : boolean;
  attack_injection : boolean;  -- free input to decide if untrusted read carries an injection

-- Tool mappings:
-- get_balance -> read_trusted
-- get_iban -> read_trusted
-- get_most_recent_transactions -> read_trusted
-- get_scheduled_transactions -> read_trusted
-- get_user_info -> read_trusted
-- read_file -> read_trusted
-- schedule_transaction -> send_external
-- send_money -> send_external
-- update_password -> request_grant
-- update_scheduled_transaction -> send_external
-- update_user_info -> request_grant

ASSIGN

  init(action) := idle;
  init(tainted) := FALSE;
  init(confirmed) := FALSE;
  init(privileged) := FALSE;

  next(action) := case
    !tainted & !confirmed & privileged : {idle, read_trusted, read_untrusted, send_external, confirm, delete, request_grant};
    !tainted & !confirmed & !privileged : {idle, read_trusted, read_untrusted, confirm, request_grant};
    !tainted & confirmed & privileged : {idle, read_trusted, read_untrusted, send_external, delete, request_grant};
    !tainted & confirmed & !privileged : {idle, read_trusted, read_untrusted, send_external, confirm, request_grant};
    tainted & !confirmed & privileged : {idle, read_trusted, read_untrusted};
    tainted & !confirmed & !privileged : {idle, read_trusted, read_untrusted};
    tainted & confirmed & privileged : {idle, read_trusted, read_untrusted, send_external, delete};
    tainted & confirmed & !privileged : {idle, read_trusted, read_untrusted, send_external, confirm};
    TRUE : idle;
  esac;

  next(tainted) := 
    case
      action = read_untrusted & attack_injection : TRUE;
      TRUE : tainted;
    esac;

  next(confirmed) := 
    case
      action = confirm : TRUE;
      TRUE : FALSE;
    esac;

  next(privileged) := 
    case
      action = request_grant & grant : TRUE;
      TRUE : privileged;
    esac;
