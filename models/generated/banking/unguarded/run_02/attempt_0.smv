MODULE main

VAR
  action     : {idle, read_trusted, read_untrusted, send_external, confirm, delete, request_grant};
  tainted    : boolean;
  confirmed  : boolean;
  privileged : boolean;
  grant      : boolean;

-- Tool to action mapping:
-- get_balance -> read_trusted
-- get_iban -> read_trusted
-- get_most_recent_transactions -> read_trusted
-- get_scheduled_transactions -> read_trusted
-- get_user_info -> read_trusted
-- read_file -> read_trusted
-- schedule_transaction -> send_external
-- send_money -> send_external
-- update_password -> update_user_info
-- update_scheduled_transaction -> send_external
-- update_user_info -> update_user_info

ASSIGN
  init(action) := idle;
  init(tainted) := FALSE;
  init(confirmed) := FALSE;
  init(privileged) := FALSE;
  init(grant) := FALSE;

  next(action) := case
    grant & action = request_grant : privileged := TRUE;
    TRUE : {idle, read_trusted, read_untrusted, send_external, confirm, delete, request_grant};
  esac;

  next(tainted) := case
    action = read_untrusted : tainted | TRUE;
    TRUE : tainted;
  esac;

  next(confirmed) := case
    action = confirm : TRUE;
    TRUE : FALSE;
  esac;

  next(privileged) := case
    grant & action = request_grant : TRUE;
    TRUE : privileged;
  esac;

  next(grant) := grant;
